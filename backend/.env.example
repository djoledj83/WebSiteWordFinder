# Copy to .env (or set these in your shell) to override the defaults.
# The server reads them at startup; every value is optional.

# HTTP port of the API (and of the built frontend in production)
PORT=4002

# Crawl limits
MAX_PAGES=200               # default page budget of a search
MAX_PAGES_LIMIT=20000       # the highest page budget a user may request from the form
MAX_DEPTH=10                # how many link hops away from the start URL to follow
MAX_EXTRA_START_URLS=5000   # how many URLs the "additional start URLs" option may expand to
CONCURRENCY=5               # pages fetched in parallel (plain HTTP)
TIMEOUT_MS=10000            # per-request timeout (plain HTTP)
MAX_BODY_BYTES=5242880      # pages larger than this (5 MB) are skipped
USER_AGENT=Mozilla/5.0 (compatible; WebSiteWordFinder/1.0)

# JavaScript rendering (Playwright/Chromium), used when a search turns on "Render JavaScript"
BROWSER_CONCURRENCY=3       # pages rendered at the same time
BROWSER_TIMEOUT_MS=20000    # time allowed for a page to load
BROWSER_SETTLE_MS=2500      # time allowed for the page's own API calls and rendering after it loaded

# Security: by default the crawler refuses private and loopback addresses
# (localhost, 10.x, 192.168.x, ...). Set to true to crawl intranet or local sites.
ALLOW_PRIVATE_ADDRESSES=false

# Finished searches are forgotten after this long (30 minutes)
JOB_TTL_MS=1800000
