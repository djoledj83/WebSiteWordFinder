# Docker settings — copy to .env next to docker-compose.yml (docker compose reads it automatically).
# Every crawl option from backend/.env.example can be added here as well.

# Port on the server (what you open in the browser)
HOST_PORT=3002

# Port inside the container; rarely needs changing
PORT=4000

# Crawl settings
ALLOW_PRIVATE_ADDRESSES=false   # "true" lets it crawl intranet / localhost sites
MAX_PAGES_LIMIT=20000
CONCURRENCY=5                   # plain-HTTP pages fetched in parallel
BROWSER_CONCURRENCY=3           # pages rendered in Chromium in parallel (each ~100-200 MB)
BROWSER_TIMEOUT_MS=20000
JOB_TTL_MS=1800000
